@implements IDisposable
@inject NavigationManager NavigationManager
@inject CurrentUserService CurrentUserService
@inject ApprovalService ApprovalService
@inject AuthenticationStateProvider AuthenticationStateProvider

<FluentNav Width="240px" UseIcons="true">
    <FluentNavItem Href="" Match="NavLinkMatch.All"
                   IconRest="@(new Icons.Regular.Size20.Home())" IconActive="@(new Icons.Filled.Size20.Home())">
        Home
    </FluentNavItem>
    <FluentNavItem Href="dashboard"
                   IconRest="@(new Icons.Regular.Size20.DataBarVertical())" IconActive="@(new Icons.Filled.Size20.DataBarVertical())">
        Dashboard
    </FluentNavItem>

    <FluentNavSectionHeader Title="Requests" />
    <FluentNavItem Href="requests/new"
                   IconRest="@(new Icons.Regular.Size20.AddSquare())" IconActive="@(new Icons.Filled.Size20.AddSquare())">
        New request
    </FluentNavItem>
    <FluentNavItem Href="requests" Match="NavLinkMatch.All"
                   IconRest="@(new Icons.Regular.Size20.DocumentBulletList())" IconActive="@(new Icons.Filled.Size20.DocumentBulletList())">
        My requests
    </FluentNavItem>
    <FluentNavItem Href="approvals"
                   IconRest="@(new Icons.Regular.Size20.TaskListSquareLtr())" IconActive="@(new Icons.Filled.Size20.TaskListSquareLtr())">
        <span class="nav-label-with-count">
            My approvals
            <FluentCounterBadge Count="@pendingApprovals" Size="BadgeSize.Small" aria-label="@($"{pendingApprovals} waiting")" />
        </span>
    </FluentNavItem>

    <AuthorizeView Roles="@($"{AppRoles.Purchasing},{AppRoles.Admin}")">
        <FluentNavSectionHeader Title="Manage" />
    </AuthorizeView>
    <AuthorizeView Roles="@AppRoles.Purchasing">
        <FluentNavItem Href="purchasing"
                       IconRest="@(new Icons.Regular.Size20.Cart())" IconActive="@(new Icons.Filled.Size20.Cart())">
            Purchasing
        </FluentNavItem>
    </AuthorizeView>
    <AuthorizeView Roles="@AppRoles.Admin">
        <FluentNavItem Href="admin/settings"
                       IconRest="@(new Icons.Regular.Size20.Settings())" IconActive="@(new Icons.Filled.Size20.Settings())">
            Settings
        </FluentNavItem>
    </AuthorizeView>
    @if (showOutbox)
    {
        <FluentNavItem Href="outbox"
                       IconRest="@(new Icons.Regular.Size20.Mail())" IconActive="@(new Icons.Filled.Size20.Mail())">
            Email outbox
        </FluentNavItem>
    }
</FluentNav>

@code {
    [Inject]
    private IWebHostEnvironment Environment { get; set; } = default!;

    private int pendingApprovals;
    private bool showOutbox;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        await RefreshAsync();
    }

    // Recount on every navigation so the badge drops after a decision.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await RefreshAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
            // The circuit closed mid-navigation.
        }
    }

    private async Task RefreshAsync()
    {
        // The nav also renders on the anonymous Error and Not found pages.
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var user = await CurrentUserService.GetAsync();
        showOutbox = Environment.IsDevelopment() || user.IsInRole(AppRoles.Admin);
        pendingApprovals = (await ApprovalService.GetQueueAsync(user)).Count;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
