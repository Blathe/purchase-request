@if (Access == AccessResult.Denied)
{
    <EmptyState Title="Access denied" Message="You do not have permission to view this request."
                Icon="@(new Icons.Regular.Size24.LockClosed())" ActionHref="requests" ActionText="Back to my requests" />
}
else if (Access == AccessResult.NotFound)
{
    <EmptyState Title="Request not found" Message="This request does not exist."
                Icon="@(new Icons.Regular.Size24.DocumentDismiss())" ActionHref="requests" ActionText="Back to my requests" />
}

@code {
    [Parameter, EditorRequired]
    public AccessResult Access { get; set; }
}
