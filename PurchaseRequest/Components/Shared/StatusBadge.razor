<FluentBadge Appearance="BadgeAppearance.Tint" Color="@Color">@Format.Status(Status)</FluentBadge>

@code {
    [Parameter, EditorRequired]
    public RequestStatus Status { get; set; }

    private BadgeColor Color => Status switch
    {
        RequestStatus.PendingApproval => BadgeColor.Warning,
        RequestStatus.Approved => BadgeColor.Success,
        RequestStatus.Ordered => BadgeColor.Informative,
        RequestStatus.Received => BadgeColor.Brand,
        RequestStatus.Rejected => BadgeColor.Danger,
        _ => BadgeColor.Subtle
    };
}
