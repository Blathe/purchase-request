@page "/admin/settings"
@attribute [Authorize(Roles = AppRoles.Admin)]
@using System.ComponentModel.DataAnnotations
@inject CurrentUserService CurrentUserService
@inject SettingsService SettingsService
@inject INotificationService Toasts

<PageTitle>Settings</PageTitle>

<PageHeader Title="Settings"
            Subtitle="Changes apply to requests submitted from now on. Requests already submitted keep the rules they were submitted under." />

@if (errorMessage is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Class="page-message">@errorMessage</FluentMessageBar>
}

@if (categories is null)
{
    <FluentProgressBar />
}
else
{
    <FluentCard Class="settings-card">
        <h2 class="section-title">Finance approval threshold</h2>
        <p class="text-subtle">Requests with a total <strong>over</strong> this amount need Finance approval.</p>
        <div class="settings-row">
            <FluentNumberInput TValue="decimal" Label="Threshold" @bind-Value="threshold" Min="@(0.01m)" Width="200px"
                               StartTemplate="@DollarSign" />
            <FluentButton Appearance="ButtonAppearance.Primary" Loading="@working" OnClick="SaveThresholdAsync">Save threshold</FluentButton>
        </div>
    </FluentCard>

    <FluentCard Class="settings-card">
        <h2 class="section-title">Categories</h2>
        <p class="text-subtle">Inactive categories are hidden from the request form. Existing requests keep them.</p>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Requires IT approval</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in categories)
                {
                    <tr class="@(category.IsActive ? "" : "is-inactive")">
                        <td>@category.Name</td>
                        <td>
                            <FluentSwitch AriaLabel="@($"{category.Name} requires IT approval")" Disabled="@working"
                                          Value="@category.RequiresItApproval"
                                          ValueChanged="@(value => SaveCategoryAsync(category, value, category.IsActive))" />
                        </td>
                        <td>
                            <FluentSwitch AriaLabel="@($"{category.Name} is active")" Disabled="@working"
                                          Value="@category.IsActive"
                                          ValueChanged="@(value => SaveCategoryAsync(category, category.RequiresItApproval, value))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <h3 class="section-title section-title-small">Add a category</h3>
        <div class="settings-row">
            <FluentTextInput Label="Name" @bind-Value="newName" MaxLength="100" Width="260px" />
            <FluentCheckbox Label="Requires IT approval" @bind-Value="newRequiresIt" />
            <FluentButton IconStart="@(new Icons.Regular.Size20.Add())" Disabled="@working" OnClick="AddCategoryAsync">Add</FluentButton>
        </div>
    </FluentCard>
}

@code {
    private static readonly RenderFragment DollarSign = @<span class="text-subtle">$</span>;

    private CurrentUser user = null!;
    private List<Category>? categories;
    private decimal threshold;
    private string? newName;
    private bool newRequiresIt;
    private bool working;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        user = await CurrentUserService.GetAsync();
        threshold = await SettingsService.GetFinanceThresholdAsync();
        categories = await SettingsService.GetCategoriesAsync();
    }

    private Task SaveThresholdAsync() => RunAsync(async () =>
    {
        await SettingsService.SetFinanceThresholdAsync(user, threshold);
        return $"Finance threshold set to {Format.Money(threshold)}.";
    });

    private Task SaveCategoryAsync(Category category, bool requiresItApproval, bool isActive) => RunAsync(async () =>
    {
        await SettingsService.UpdateCategoryAsync(user, category.Id, requiresItApproval, isActive);
        return $"Saved {category.Name}.";
    });

    private Task AddCategoryAsync() => RunAsync(async () =>
    {
        var added = await SettingsService.AddCategoryAsync(user, newName ?? "", newRequiresIt);
        newName = null;
        newRequiresIt = false;
        return $"Added {added.Name}.";
    });

    private async Task RunAsync(Func<Task<string>> action)
    {
        working = true;
        errorMessage = null;
        try
        {
            var success = await action();
            await Toasts.ShowSuccessToastAsync(success);
        }
        catch (Exception ex) when (ex is ValidationException or InvalidOperationException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            categories = await SettingsService.GetCategoriesAsync();
            working = false;
        }
    }
}
