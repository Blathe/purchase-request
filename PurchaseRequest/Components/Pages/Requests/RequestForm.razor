@page "/requests/new"
@page "/requests/{Id:int}/edit"
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject CurrentUserService CurrentUserService
@inject RequestService RequestService
@inject NavigationManager Navigation

<PageTitle>@(Id is null ? "New request" : $"Edit {number}")</PageTitle>

@if (access != AccessResult.Allowed)
{
    <AccessMessage Access="access" />
}
else if (editContext is null || categories is null)
{
    <FluentProgressBar />
}
else if (!editable)
{
    <PageHeader Title="@(number ?? "")" Subtitle="This request has been submitted and can no longer be edited." />
    <FluentAnchorButton Href="@($"requests/{Id}")">View request</FluentAnchorButton>
}
else
{
    <PageHeader Title="@(Id is null ? "New request" : $"Edit {number}")"
                Subtitle="Save it as a draft, then submit it for approval from the request page." />

    <EditForm EditContext="editContext" OnValidSubmit="SaveAsync" FormName="request-form" class="request-form">
        <DataAnnotationsValidator />

        @if (errorMessage is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@errorMessage</FluentMessageBar>
        }

        <section class="form-section">
            <h2 class="section-title">Details</h2>
            <div class="form-grid">
                <FluentTextInput Label="Vendor" Required="true" @bind-Value="model.Vendor" MaxLength="200" Class="span-2" />
                <FluentSelect TOption="Category" TValue="int" Label="Category" Required="true" Items="@categories"
                              Placeholder="Choose a category" @bind-Value="model.CategoryId"
                              OptionValue="@(c => c.Id)" OptionText="@CategoryText" />
                <FluentDatePicker TValue="DateOnly?" Label="Needed by (optional)" @bind-Value="model.NeededBy" />
                <FluentTextArea Label="Justification" Required="true" @bind-Value="model.Justification" MaxLength="2000"
                                Placeholder="What is this for, and why is it needed now?" Class="span-full" AutoResize="true" />
            </div>
        </section>

        <section class="form-section">
            <h2 class="section-title">Line items</h2>
            <div class="line-items" role="table" aria-label="Line items">
                <div class="line-item line-item-header" role="row">
                    <span role="columnheader">Description</span>
                    <span role="columnheader">Quantity</span>
                    <span role="columnheader">Unit price</span>
                    <span role="columnheader">Link (optional)</span>
                    <span role="columnheader" class="line-total">Line total</span>
                    <span role="columnheader"><span class="visually-hidden">Remove</span></span>
                </div>
                @for (var i = 0; i < model.LineItems.Count; i++)
                {
                    var line = model.LineItems[i];
                    var row = i + 1;
                    <div class="line-item" role="row" @key="line">
                        <FluentTextInput AriaLabel="@($"Line {row} description")" @bind-Value="line.Description" MaxLength="500" />
                        <FluentNumberInput TValue="int" AriaLabel="@($"Line {row} quantity")" @bind-Value="line.Quantity" Min="1" Immediate="true" />
                        <FluentNumberInput TValue="decimal" AriaLabel="@($"Line {row} unit price")" @bind-Value="line.UnitPrice" Min="@(0.01m)" Immediate="true"
                                           StartTemplate="@DollarSign" />
                        <FluentTextInput AriaLabel="@($"Line {row} link")" @bind-Value="line.Url" TextInputType="TextInputType.Url" Placeholder="https://" />
                        <span class="line-total" role="cell">@Format.Money(line.LineTotal)</span>
                        <FluentButton Appearance="ButtonAppearance.Transparent" IconOnly="true" Title="@($"Remove line {row}")"
                                      IconStart="@(new Icons.Regular.Size20.Delete())" aria-label="@($"Remove line {row}")"
                                      Disabled="@(model.LineItems.Count == 1)" OnClick="() => RemoveLine(line)" />
                    </div>
                }
            </div>
            <div class="line-items-footer">
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="AddLine">Add line</FluentButton>
                <div class="form-total" aria-live="polite">
                    <span class="text-subtle">Total</span>
                    <strong>@Format.Money(model.Total)</strong>
                </div>
            </div>
        </section>

        <div class="form-actions">
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Loading="@saving">Save draft</FluentButton>
            <FluentAnchorButton Href="@(Id is null ? "requests" : $"requests/{Id}")" Appearance="ButtonAppearance.Subtle">Cancel</FluentAnchorButton>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private RequestFormModel model = new();
    private EditContext? editContext;
    private ValidationMessageStore? lineMessages;
    private List<Category>? categories;
    private AccessResult access = AccessResult.Allowed;
    private string? number;
    private bool editable = true;
    private bool saving;
    private string? errorMessage;
    private CurrentUser user = null!;
    private int userId => user.Id;

    protected override async Task OnInitializedAsync()
    {
        user = await CurrentUserService.GetAsync();
        categories = await RequestService.GetActiveCategoriesAsync();

        if (Id is int id)
        {
            var result = await RequestService.GetForViewAsync(id, user);
            // Only the requester edits a request, even if others can view it.
            access = result.Request is { } found && found.RequesterId != user.Id ? AccessResult.Denied : result.Access;
            if (access != AccessResult.Allowed || result.Request is not { } request)
            {
                return;
            }
            number = request.Number;
            editable = RequestService.CanEdit(request);
            model = RequestFormModel.FromRequest(request);
        }

        editContext = new EditContext(model);
        lineMessages = new ValidationMessageStore(editContext);
        editContext.OnValidationRequested += ValidateLineItems;
        editContext.OnFieldChanged += ClearLineMessage;
    }

    // DataAnnotationsValidator only checks top-level properties on submit, so line items are checked here.
    private void ValidateLineItems(object? sender, ValidationRequestedEventArgs e)
    {
        lineMessages!.Clear();
        foreach (var line in model.LineItems)
        {
            var results = new List<ValidationResult>();
            Validator.TryValidateObject(line, new ValidationContext(line), results, validateAllProperties: true);
            foreach (var result in results)
            {
                foreach (var member in result.MemberNames)
                {
                    lineMessages.Add(new FieldIdentifier(line, member), result.ErrorMessage ?? "Invalid value.");
                }
            }
        }
    }

    private void ClearLineMessage(object? sender, FieldChangedEventArgs e) => lineMessages!.Clear(e.FieldIdentifier);

    private static readonly RenderFragment DollarSign = @<span class="text-subtle">$</span>;

    private static string CategoryText(Category category) =>
        category.RequiresItApproval ? $"{category.Name} (needs IT approval)" : category.Name;

    private void AddLine() => model.LineItems.Add(new LineItemModel());

    private void RemoveLine(LineItemModel line)
    {
        model.LineItems.Remove(line);
        lineMessages!.Clear();
        editContext!.NotifyValidationStateChanged();
    }

    private async Task SaveAsync()
    {
        saving = true;
        errorMessage = null;
        try
        {
            if (Id is int id)
            {
                var result = await RequestService.UpdateDraftAsync(id, userId, model);
                access = result.Access;
                if (result.Access is AccessResult.Allowed)
                {
                    Navigation.NavigateTo($"requests/{id}");
                }
            }
            else
            {
                var request = await RequestService.CreateDraftAsync(userId, model);
                Navigation.NavigateTo($"requests/{request.Id}");
            }
        }
        catch (Exception ex) when (ex is ValidationException or InvalidOperationException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    public void Dispose()
    {
        if (editContext is not null)
        {
            editContext.OnValidationRequested -= ValidateLineItems;
            editContext.OnFieldChanged -= ClearLineMessage;
        }
    }
}
