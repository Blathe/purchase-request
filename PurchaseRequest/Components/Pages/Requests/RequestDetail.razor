@page "/requests/{Id:int}"
@using System.ComponentModel.DataAnnotations
@inject CurrentUserService CurrentUserService
@inject RequestService RequestService
@inject ApprovalService ApprovalService
@inject PurchasingService PurchasingService
@inject IDialogService DialogService
@inject INotificationService Toasts

<PageTitle>@(request?.Number ?? "Request")</PageTitle>

@if (access != AccessResult.Allowed)
{
    <AccessMessage Access="access" />
}
else if (request is null)
{
    <FluentProgressBar />
}
else
{
    var isRequester = request.RequesterId == user.Id;
    var currentStep = ApprovalService.CurrentStep(request);

    <PageHeader Title="@request.Number" Subtitle="@($"{request.Vendor} · {Format.Money(request.Total)} · requested by {request.Requester.DisplayName}")">
        <TitleSuffix>
            <StatusBadge Status="request.Status" />
        </TitleSuffix>
        <Actions>
            @if (isRequester && RequestService.CanEdit(request))
            {
                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Send())"
                              Loading="@working" OnClick="SubmitAsync">
                    Submit for approval
                </FluentButton>
                <FluentAnchorButton Href="@($"requests/{request.Id}/edit")" IconStart="@(new Icons.Regular.Size20.Edit())">Edit</FluentAnchorButton>
            }
            @if (isRequester && RequestService.CanCancel(request))
            {
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Dismiss())"
                              Disabled="@working" OnClick="CancelAsync">
                    Cancel request
                </FluentButton>
            }
        </Actions>
    </PageHeader>

    @if (errorMessage is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" Class="page-message">@errorMessage</FluentMessageBar>
    }

    @if (ApprovalService.CanDecide(request, currentStep, user))
    {
        <FluentCard Class="action-card action-card-decision">
            <h2 class="section-title">Your decision: @Format.Step(currentStep!.StepType) approval</h2>
            <FluentTextArea Label="Comment" @bind-Value="decisionComment" Placeholder="Required to return or reject"
                            AutoResize="true" />
            <div class="action-card-buttons">
                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size20.Checkmark())"
                              Loading="@working" OnClick="() => DecideAsync(Decision.Approved)">
                    Approve
                </FluentButton>
                <FluentButton IconStart="@(new Icons.Regular.Size20.ArrowUndo())" Disabled="@working"
                              OnClick="() => DecideAsync(Decision.Returned)">
                    Return for changes
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Dismiss())"
                              Disabled="@working" OnClick="() => DecideAsync(Decision.Rejected)">
                    Reject
                </FluentButton>
            </div>
        </FluentCard>
    }

    @if (PurchasingService.CanMarkOrdered(request, user) || PurchasingService.CanMarkReceived(request, user))
    {
        var ordering = request.Status == RequestStatus.Approved;
        <FluentCard Class="action-card">
            <h2 class="section-title">Purchasing</h2>
            <FluentTextArea Label="Comment (optional)" @bind-Value="purchasingComment"
                            Placeholder="For example a PO number or tracking link" AutoResize="true" />
            <div class="action-card-buttons">
                <FluentButton Appearance="ButtonAppearance.Primary" Loading="@working" OnClick="() => MarkAsync(ordering)"
                              IconStart="@(ordering ? new Icons.Regular.Size20.Cart() : new Icons.Regular.Size20.BoxCheckmark())">
                    @(ordering ? "Mark ordered" : "Mark received")
                </FluentButton>
            </div>
        </FluentCard>
    }

    <div class="detail-layout">
        <div class="detail-main">
            <section class="form-section">
                <h2 class="section-title">Details</h2>
                <dl class="detail-list">
                    <dt>Category</dt>
                    <dd>@request.Category.Name</dd>
                    <dt>Needed by</dt>
                    <dd>@(request.NeededBy is { } neededBy ? Format.Date(neededBy) : "—")</dd>
                    <dt>Created</dt>
                    <dd>@Format.DateAndTime(request.CreatedAt)</dd>
                    @if (request.SubmittedAt is { } submittedAt)
                    {
                        <dt>Submitted</dt>
                        <dd>@Format.DateAndTime(submittedAt)</dd>
                    }
                    <dt>Justification</dt>
                    <dd class="preserve-lines">@request.Justification</dd>
                </dl>
            </section>

            <section class="form-section">
                <h2 class="section-title">Line items</h2>
                <FluentDataGrid Items="@request.LineItems.AsQueryable()" TGridItem="LineItem" GridTemplateColumns="2fr 90px 120px 130px">
                    <TemplateColumn Title="Description">
                        @context.Description
                        @if (context.Url is not null)
                        {
                            <a href="@context.Url" target="_blank" rel="noopener noreferrer">link</a>
                        }
                    </TemplateColumn>
                    <PropertyColumn Title="Quantity" Property="@(l => l.Quantity)" Align="DataGridCellAlignment.End" />
                    <TemplateColumn Title="Unit price" Align="DataGridCellAlignment.End">@Format.Money(context.UnitPrice)</TemplateColumn>
                    <TemplateColumn Title="Line total" Align="DataGridCellAlignment.End">@Format.Money(context.LineTotal)</TemplateColumn>
                </FluentDataGrid>
                <div class="form-total">
                    <span class="text-subtle">Total</span>
                    <strong>@Format.Money(request.Total)</strong>
                </div>
            </section>
        </div>

        <aside class="detail-side">
            <section class="form-section">
                <h2 class="section-title">Approvals</h2>
                <ApprovalTimeline Steps="request.ApprovalSteps" CurrentStep="currentStep" />
                @if (request.ThresholdAtSubmit is { } threshold)
                {
                    <p class="text-subtle">Finance approval threshold when submitted: @Format.Money(threshold)</p>
                }
            </section>

            <section class="form-section">
                <h2 class="section-title">History</h2>
                <ol class="history-list">
                    @foreach (var entry in request.History.OrderByDescending(h => h.OccurredAt))
                    {
                        <li>
                            <div><strong>@entry.Action</strong> by @entry.User.DisplayName</div>
                            <div class="text-subtle">@Format.DateAndTime(entry.OccurredAt)</div>
                            @if (entry.Comment is not null)
                            {
                                <blockquote class="timeline-comment">@entry.Comment</blockquote>
                            }
                        </li>
                    }
                </ol>
            </section>
        </aside>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Request? request;
    private CurrentUser user = null!;
    private AccessResult access = AccessResult.Allowed;
    private bool working;
    private string? decisionComment;
    private string? purchasingComment;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        user = await CurrentUserService.GetAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await RequestService.GetForViewAsync(Id, user);
        access = result.Access;
        request = result.Request;
    }

    private Task SubmitAsync() => RunAsync(async () =>
    {
        await ApprovalService.SubmitAsync(Id, user.Id);
        return "Submitted. Your approvers have been notified.";
    });

    private async Task CancelAsync()
    {
        if (await ConfirmAsync("Cancel this request? This cannot be undone.", "Cancel request", "Cancel request", "Keep it"))
        {
            await RunAsync(async () =>
            {
                await RequestService.CancelAsync(Id, user.Id);
                return "Request cancelled.";
            });
        }
    }

    private async Task DecideAsync(Decision decision)
    {
        // Reject is final, so ask first. Without a comment, skip the dialog and let the service explain what is missing.
        if (decision == Decision.Rejected && !string.IsNullOrWhiteSpace(decisionComment)
            && !await ConfirmAsync("Reject this request? The requester will need to start a new one.", "Reject request", "Reject", "Go back"))
        {
            return;
        }

        await RunAsync(async () =>
        {
            await ApprovalService.DecideAsync(Id, user, decision, decisionComment);
            decisionComment = null;
            return decision switch
            {
                Decision.Approved => "Approved.",
                Decision.Returned => "Returned to the requester for changes.",
                _ => "Rejected."
            };
        });
    }

    private Task MarkAsync(bool ordering) => RunAsync(async () =>
    {
        if (ordering)
        {
            await PurchasingService.MarkOrderedAsync(Id, user, purchasingComment);
        }
        else
        {
            await PurchasingService.MarkReceivedAsync(Id, user, purchasingComment);
        }
        purchasingComment = null;
        return ordering ? "Marked ordered. The requester has been notified." : "Marked received. The requester has been notified.";
    });

    private async Task<bool> ConfirmAsync(string message, string title, string confirm, string cancel)
    {
        var result = await DialogService.ShowConfirmationAsync(message, title, confirm, cancel);
        return !result.Cancelled;
    }

    // Runs an action, reloads the request, and shows the action's success message as a toast.
    private async Task RunAsync(Func<Task<string>> action)
    {
        working = true;
        errorMessage = null;
        try
        {
            var success = await action();
            await LoadAsync();
            await Toasts.ShowSuccessToastAsync(success);
        }
        catch (Exception ex) when (ex is ValidationException or InvalidOperationException)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            working = false;
        }
    }
}
