@page "/purchasing"
@attribute [Authorize(Roles = AppRoles.Purchasing)]
@inject PurchasingService PurchasingService

<PageTitle>Purchasing</PageTitle>

<PageHeader Title="Purchasing" Subtitle="Approved requests to order, then ordered requests to receive." />

@if (requests is null)
{
    <FluentProgressBar />
}
else if (requests.Count == 0)
{
    <EmptyState Title="Nothing to order" Message="Approved requests appear here until they are received."
                Icon="@(new Icons.Regular.Size24.Cart())" />
}
else
{
    <ListToolbar @bind-Search="search" Statuses="@statuses" @bind-Status="status" Count="@Filtered.Count()" />

    <FluentDataGrid Items="@Filtered" TGridItem="Request" ItemKey="@(r => r.Id)" ShowHover="true"
                    GridTemplateColumns="130px 1fr 1.5fr 1fr 120px 120px 120px">
        <EmptyContent>No requests match your search.</EmptyContent>
        <ChildContent>
            <TemplateColumn Title="Number" SortBy="@byNumber">
                <a href="requests/@context.Id">@context.Number</a>
            </TemplateColumn>
            <PropertyColumn Title="Requester" Property="@(r => r.Requester.DisplayName)" Sortable="true" />
            <PropertyColumn Title="Vendor" Property="@(r => r.Vendor)" Sortable="true" />
            <PropertyColumn Title="Category" Property="@(r => r.Category.Name)" Sortable="true" />
            <TemplateColumn Title="Total" SortBy="@byTotal" Align="DataGridCellAlignment.End">
                @Format.Money(context.Total)
            </TemplateColumn>
            <TemplateColumn Title="Needed by" SortBy="@byNeededBy">
                @(context.NeededBy is { } neededBy ? Format.Date(neededBy) : "—")
            </TemplateColumn>
            <TemplateColumn Title="Status" SortBy="@byStatus">
                <StatusBadge Status="context.Status" />
            </TemplateColumn>
        </ChildContent>
    </FluentDataGrid>
}

@code {
    private static readonly RequestStatus[] statuses = [RequestStatus.Approved, RequestStatus.Ordered];
    private static readonly GridSort<Request> byNumber = GridSort<Request>.ByAscending(r => r.Number);
    private static readonly GridSort<Request> byTotal = GridSort<Request>.ByAscending(r => r.Total);
    private static readonly GridSort<Request> byNeededBy = GridSort<Request>.ByAscending(r => r.NeededBy ?? DateOnly.MaxValue);
    private static readonly GridSort<Request> byStatus = GridSort<Request>.ByAscending(r => r.Status);

    private List<Request>? requests;
    private string? search;
    private string? status = "";

    private IQueryable<Request> Filtered => (requests ?? [])
        .Where(r => ListToolbar.Matches(search, r.Number, r.Vendor) && ListToolbar.Matches(status, r.Status))
        .AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        requests = await PurchasingService.GetQueueAsync();
    }
}
