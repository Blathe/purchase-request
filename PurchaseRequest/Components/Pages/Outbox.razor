@page "/outbox"
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject CurrentUserService CurrentUserService
@inject IWebHostEnvironment Environment

<PageTitle>Email outbox</PageTitle>

@if (!allowed)
{
    <PageHeader Title="Access denied" Subtitle="The outbox is available to Admins, or to everyone while running in Development." />
}
else
{
    <PageHeader Title="Email outbox" Subtitle="Emails are logged here instead of being sent. Newest first, last 100." />

    @if (messages is null)
    {
        <FluentProgressBar />
    }
    else if (messages.Count == 0)
    {
        <EmptyState Title="No emails yet" Message="Submitting or deciding on a request sends emails, which appear here."
                    Icon="@(new Icons.Regular.Size24.Mail())" />
    }
    else
    {
        <ListToolbar @bind-Search="search" SearchPlaceholder="Search by recipient or subject" />

        <div class="outbox-list">
            @foreach (var message in Filtered)
            {
                <FluentCard>
                    <div class="outbox-heading">
                        <strong>@message.Subject</strong>
                        <span class="text-subtle">@Format.DateAndTime(message.CreatedAt)</span>
                    </div>
                    <div class="text-subtle">To: @message.To</div>
                    <div class="outbox-body">@message.Body</div>
                </FluentCard>
            }
        </div>
    }
}

@code {
    private List<OutboxMessage>? messages;
    private bool allowed;
    private string? search;

    private IEnumerable<OutboxMessage> Filtered => string.IsNullOrWhiteSpace(search)
        ? messages ?? []
        : (messages ?? []).Where(m => m.To.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase)
            || m.Subject.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUserService.GetAsync();
        allowed = Environment.IsDevelopment() || user.IsInRole(AppRoles.Admin);
        if (!allowed)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        messages = await db.OutboxMessages.AsNoTracking()
            .OrderByDescending(m => m.Id)
            .Take(100)
            .ToListAsync();
    }
}
