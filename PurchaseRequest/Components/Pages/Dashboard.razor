@page "/dashboard"
@inject CurrentUserService CurrentUserService
@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<PageHeader Title="Dashboard" />

@if (dashboard is null)
{
    <FluentProgressBar />
}
else
{
    <div class="kpi-grid">
        <a href="approvals" class="kpi-link">
            <FluentCard Class="kpi-card">
                <FluentIcon Value="@(new Icons.Regular.Size24.TaskListSquareLtr())" />
                <div>
                    <div class="text-subtle">Waiting on your approval</div>
                    <div class="kpi-value">@dashboard.PendingApprovals</div>
                </div>
            </FluentCard>
        </a>
        <FluentCard Class="kpi-card">
            <FluentIcon Value="@(new Icons.Regular.Size24.Money())" />
            <div>
                <div class="text-subtle">@(dashboard.IsManager ? "Team spend" : "Your spend") in @dashboard.Year</div>
                <div class="kpi-value">@Format.Money(dashboard.Total)</div>
            </div>
        </FluentCard>
    </div>

    <p class="text-subtle">
        @(dashboard.IsManager ? "Approved requests from your direct reports" : "Your approved requests"),
        including ordered and received, by the month they were submitted.
    </p>

    @if (dashboard.ByMonth.Count == 0)
    {
        <EmptyState Title="No approved spend yet this year" Icon="@(new Icons.Regular.Size24.DataBarVertical())"
                    Message="Spend appears here once requests are approved." />
    }
    else
    {
        <div class="spend-grid">
            <FluentCard>
                <SpendTable Title="By month" LabelHeader="Month" Rows="dashboard.ByMonth" />
            </FluentCard>
            <FluentCard>
                <SpendTable Title="By category" LabelHeader="Category" Rows="dashboard.ByCategory" />
            </FluentCard>
        </div>
    }
}

@code {
    private DashboardSummary? dashboard;

    protected override async Task OnInitializedAsync()
    {
        var user = await CurrentUserService.GetAsync();
        dashboard = await DashboardService.GetAsync(user);
    }
}
