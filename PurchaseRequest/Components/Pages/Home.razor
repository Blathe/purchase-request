@page "/"

<PageTitle>Purchase Requests</PageTitle>

<PageHeader Title="Purchase Requests" Subtitle="Submit purchase requests and track them through approval and ordering." />

<div class="home-grid">
    <a href="requests/new" class="kpi-link">
        <FluentCard Class="home-card">
            <FluentIcon Value="@(new Icons.Regular.Size24.AddSquare())" />
            <h2 class="section-title">New request</h2>
            <p class="text-subtle">Add what you need to buy and send it for approval.</p>
        </FluentCard>
    </a>
    <a href="requests" class="kpi-link">
        <FluentCard Class="home-card">
            <FluentIcon Value="@(new Icons.Regular.Size24.DocumentBulletList())" />
            <h2 class="section-title">My requests</h2>
            <p class="text-subtle">See where each of your requests is and who it is waiting on.</p>
        </FluentCard>
    </a>
    <a href="approvals" class="kpi-link">
        <FluentCard Class="home-card">
            <FluentIcon Value="@(new Icons.Regular.Size24.TaskListSquareLtr())" />
            <h2 class="section-title">My approvals</h2>
            <p class="text-subtle">Approve, return or reject requests waiting on you.</p>
        </FluentCard>
    </a>
</div>
